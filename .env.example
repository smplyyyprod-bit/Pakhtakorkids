# ---------------------------------------------------------------- Telegram
# Token from @BotFather. Never commit the real value.
TELEGRAM_BOT_TOKEN=

# Telegram user IDs, comma separated. Get yours from @userinfobot.
# These accounts are created/promoted on every startup.
# Administrators fill in daily reports and cannot see company analytics.
TELEGRAM_ADMIN_IDS=
# Managers see analytics, exports and the administration panel.
TELEGRAM_MANAGER_IDS=

# ---------------------------------------------------------------- Database
# Used directly when running outside Docker. Under docker compose the bot
# service builds this from DB_USER / DB_PASSWORD / DB_NAME below.
DATABASE_URL=postgresql://coaching_user:changeme@localhost:5432/coaching_management
DATABASE_ECHO=false

# Used by docker compose.
DB_USER=coaching_user
DB_PASSWORD=changeme
DB_NAME=coaching_management

# ------------------------------------------------------------------- Redis
# Optional but recommended: without it, a restart loses any half-finished form.
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------------- Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# --------------------------------------------------------------- Scheduler
SCHEDULER_TIMEZONE=Asia/Tashkent
# Nightly creation of placeholder reports (HH:MM, local to the timezone above).
AUTO_REPORT_GENERATION_TIME=23:30
# Evening reminder about unfilled reports.
INCOMPLETE_REPORT_REMINDER_TIME=19:00

# ------------------------------------------------------------- Environment
ENVIRONMENT=production
DEBUG=false
