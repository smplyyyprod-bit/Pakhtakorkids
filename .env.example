# Telegram Bot
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_IDS=123456789,987654321

# Database
DATABASE_URL=postgresql://user:password@postgres:5432/coaching_management
DATABASE_ECHO=false

# Redis (optional)
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Scheduler
SCHEDULER_TIMEZONE=Asia/Tashkent
AUTO_REPORT_GENERATION_TIME=23:30

# Environment
ENVIRONMENT=development
DEBUG=false

# Server
BOT_WEBHOOK_PATH=/webhook
BOT_WEBHOOK_PORT=8080
BOT_WEBHOOK_HOST=0.0.0.0
